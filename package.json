{
  "name": "rainrail",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-ready development event routing and workflow orchestration suite.",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm run build:scripts && pnpm --filter www build",
    "build:scripts": "node scripts/check-scripts.mjs",
    "cf:deploy": "node scripts/validate-cloudflare-secrets.mjs && wrangler deploy",
    "cf:dev": "wrangler dev --local",
    "cf:smoke": "node scripts/smoke-cloudflare-worker.mjs",
    "docs:check": "node scripts/check-docs-drift.mjs && tsc -p tsconfig.docs.json",
    "test": "vitest run scripts src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.3",
    "wrangler": "^4.105.0"
  }
}
