---
import { getDashboardRouteBySlug, getDashboardRoutes } from '../../lib/dashboard-content';
import { getDefaultLocaleDashboardRedirect } from '../../lib/redirects';

export function getStaticPaths() {
  return getDashboardRoutes()
    .flatMap((route) => {
      const routeViews = route.slug === undefined ? [] : [route.slug, ...(route.aliases ?? [])];
      return routeViews.map((view) => ({
        params: { view },
        props: { view },
      }));
    });
}

type Props = {
  view: string;
};

const { view } = Astro.props as Props;
const route = getDashboardRouteBySlug(view);

if (route === undefined) {
  throw new Error(`Unsupported dashboard route: ${view}`);
}

const redirect = getDefaultLocaleDashboardRedirect(route.id);
const redirectHref = redirect.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ redirectHref }}>
      const target = new URL(redirectHref, window.location.href);
      target.search = window.location.search;
      target.hash = window.location.hash;
      window.location.replace(target.toString());
    </script>
    <meta http-equiv="refresh" content={`0;url=${redirect.href}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={redirect.href} />
    <title>{redirect.title}</title>
  </head>
  <body>
    <a href={redirect.href}>{redirect.body}</a>
  </body>
</html>
