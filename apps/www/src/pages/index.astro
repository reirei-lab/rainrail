---
import { getLocaleHref } from '../lib/i18n';

const japaneseHref = getLocaleHref('ja', 'home');
const englishHref = getLocaleHref('en', 'home');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Rainrail</title>
    <script is:inline define:vars={{ japaneseHref, englishHref }}>
      const languages = navigator.languages?.length
        ? navigator.languages
        : [navigator.language || 'en'];
      const prefersJapanese = languages.some((language) =>
        language.toLowerCase().startsWith('ja'),
      );

      window.location.replace(prefersJapanese ? japaneseHref : englishHref);
    </script>
  </head>
  <body>
    <main>
      <h1>Rainrail</h1>
      <p>Select a language.</p>
      <ul>
        <li><a href={japaneseHref}>日本語</a></li>
        <li><a href={englishHref}>English</a></li>
      </ul>
    </main>
  </body>
</html>
