---
import '../styles/global.css';
import { getDashboardHref } from '../lib/dashboard-content';
import { defaultLocale, getOgLocale, supportedLocales, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const pageTitle = `${title} - Rainrail`;
const ogLocale = getOgLocale(locale);
const canonicalHref =
  Astro.site ? new URL(getDashboardHref(locale), Astro.site).toString() : getDashboardHref(locale);
const hreflangs = [...supportedLocales, 'x-default'] as const;
const alternates = Object.fromEntries(
  hreflangs.map((hreflang) => {
    const targetLocale: Locale = hreflang === 'x-default' ? defaultLocale : hreflang;

    return [
      hreflang,
      Astro.site
        ? new URL(getDashboardHref(targetLocale), Astro.site).toString()
        : getDashboardHref(targetLocale),
    ];
  }),
);
const localeLabel = (targetLocale: Locale) =>
  targetLocale === 'ja' ? '日本語' : 'English';
const languageSwitcherLabel = locale === 'ja' ? '言語切替' : 'Language switcher';
const languagePreferenceKey = 'rainrail.locale';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      supportedLocales.map((alternateLocale) => (
        <link rel="alternate" hreflang={alternateLocale} href={alternates[alternateLocale]} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternates['x-default']} />
    {
      supportedLocales
        .filter((alternateLocale) => alternateLocale !== locale)
        .map((alternateLocale) => (
          <meta property="og:locale:alternate" content={getOgLocale(alternateLocale)} />
        ))
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="dashboard-page-shell">
      <div class="dashboard-language-switcher language-switcher" aria-label={languageSwitcherLabel}>
        {supportedLocales.map((targetLocale) => (
          <a
            href={getDashboardHref(targetLocale)}
            data-locale-choice={targetLocale}
            aria-current={targetLocale === locale ? 'true' : undefined}
          >
            {localeLabel(targetLocale)}
          </a>
        ))}
      </div>
      <slot />
    </main>
    <script is:inline define:vars={{ languagePreferenceKey }}>
      document.querySelectorAll('[data-locale-choice]').forEach((link) => {
        link.addEventListener('click', () => {
          const locale = link.getAttribute('data-locale-choice');
          try {
            window.localStorage?.setItem(languagePreferenceKey, locale);
          } catch {
            // Continue navigation even when storage is unavailable.
          }
        });
      });
    </script>
  </body>
</html>
