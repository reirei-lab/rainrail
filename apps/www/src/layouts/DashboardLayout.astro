---
import '../styles/global.css';
import {
  getDashboardContent,
  getDashboardHref,
  getDashboardRoutes,
  type DashboardRouteId,
} from '../lib/dashboard-content';
import { defaultLocale, getOgLocale, supportedLocales, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  activeRoute?: DashboardRouteId;
  dashboardCopy: string;
  apiBaseUrl: string;
}

const { title, description, locale, activeRoute = 'overview', dashboardCopy, apiBaseUrl } = Astro.props;
const content = getDashboardContent(locale);
const dashboardRoutes = getDashboardRoutes();
const dashboardCoreCardByRoute: Partial<Record<DashboardRouteId, string>> = {
  events: 'core.eventInbox',
  'workflow-runs': 'core.workflowRuns',
  'agent-tasks': 'core.agentTasks',
  sources: 'core.sources',
  queue: 'core.queue',
  settings: 'core.settings',
};
const dashboardRouteLabels = {
  overview: content.shell.tabs.overview,
  events: content.shell.tabs.events,
  'workflow-runs': content.shell.tabs.workflowRuns,
  'agent-tasks': content.shell.tabs.agentTasks,
  sources: content.shell.tabs.sources,
  queue: content.shell.tabs.queue,
  settings: content.shell.tabs.settings,
} as const satisfies Record<DashboardRouteId, string>;
const pageTitle = `${title} - Rainrail`;
const ogLocale = getOgLocale(locale);
const canonicalHref =
  Astro.site ? new URL(getDashboardHref(locale, activeRoute), Astro.site).toString() : getDashboardHref(locale, activeRoute);
const hreflangs = [...supportedLocales, 'x-default'] as const;
const alternates = Object.fromEntries(
  hreflangs.map((hreflang) => {
    const targetLocale: Locale = hreflang === 'x-default' ? defaultLocale : hreflang;

    return [
      hreflang,
      Astro.site
        ? new URL(getDashboardHref(targetLocale, activeRoute), Astro.site).toString()
        : getDashboardHref(targetLocale, activeRoute),
    ];
  }),
);
const localeLabel = (targetLocale: Locale) =>
  targetLocale === 'ja' ? '日本語' : 'English';
const languageSwitcherLabel = locale === 'ja' ? '言語切替' : 'Language switcher';
const languagePreferenceKey = 'rainrail.locale';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      supportedLocales.map((alternateLocale) => (
        <link rel="alternate" hreflang={alternateLocale} href={alternates[alternateLocale]} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternates['x-default']} />
    {
      supportedLocales
        .filter((alternateLocale) => alternateLocale !== locale)
        .map((alternateLocale) => (
          <meta property="og:locale:alternate" content={getOgLocale(alternateLocale)} />
        ))
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="dashboard-page-shell">
      <div class="dashboard-language-switcher language-switcher" aria-label={languageSwitcherLabel}>
        {supportedLocales.map((targetLocale) => (
          <a
            href={getDashboardHref(targetLocale, activeRoute)}
            data-locale-choice={targetLocale}
            aria-current={targetLocale === locale ? 'true' : undefined}
          >
            {localeLabel(targetLocale)}
          </a>
        ))}
      </div>
      <section
        class="dashboard-shell"
        data-dashboard-app
        data-dashboard-copy={dashboardCopy}
        data-api-base-url={apiBaseUrl}
        data-auth-required="true"
        data-state="auth-missing"
        data-live-strategy="polling"
        data-active-dashboard-route={activeRoute}
      >
        <aside class="dashboard-sidebar" aria-label={content.shell.navLabel}>
          <a class="dashboard-brand" href={content.shell.brandHref} aria-label={content.shell.brandLabel}>Rainrail</a>
          <nav>
            {dashboardRoutes.map((route) => (
              <a
                href={getDashboardHref(locale, route.id)}
                data-dashboard-tab={route.id}
                data-dashboard-core-card={dashboardCoreCardByRoute[route.id]}
                aria-current={route.id === activeRoute ? 'page' : undefined}
                aria-pressed={route.id === activeRoute ? 'true' : 'false'}
              >
                {dashboardRouteLabels[route.id]}
              </a>
            ))}
          </nav>
          <label class="dashboard-permission">
            <input type="checkbox" data-permission-toggle />
            {content.shell.operatorControls}
          </label>
        </aside>
        <slot />
      </section>
    </main>
    <script is:inline define:vars={{ languagePreferenceKey }}>
      document.querySelectorAll('[data-locale-choice]').forEach((link) => {
        link.addEventListener('click', () => {
          const locale = link.getAttribute('data-locale-choice');
          try {
            window.localStorage?.setItem(languagePreferenceKey, locale);
          } catch {
            // Continue navigation even when storage is unavailable.
          }
        });
      });
    </script>
  </body>
</html>
