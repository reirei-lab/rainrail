---
import '../styles/global.css';
import { getDashboardHref } from '../lib/dashboard-content';
import { supportedLocales, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const canonicalHref =
  Astro.site ? new URL(getDashboardHref(locale), Astro.site).toString() : getDashboardHref(locale);
const alternates = Object.fromEntries(
  supportedLocales.map((targetLocale) => [
    targetLocale,
    Astro.site
      ? new URL(getDashboardHref(targetLocale), Astro.site).toString()
      : getDashboardHref(targetLocale),
  ]),
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalHref} />
    {
      Object.entries(alternates).map(([alternateLocale, href]) => (
        <link rel="alternate" hreflang={alternateLocale} href={href} />
      ))
    }
    <title>{title} - Rainrail</title>
  </head>
  <body>
    <main class="dashboard-page-shell">
      <slot />
    </main>
  </body>
</html>
