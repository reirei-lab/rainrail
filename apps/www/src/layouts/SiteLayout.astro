---
import {
  getLegacyHref,
  getLocaleHref,
  getPageContent,
  getSiteMessages,
  supportedLocales,
  type Locale,
  type PageId,
} from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  pageId?: PageId;
}

const { locale = 'en', pageId, title, description } = Astro.props;
const site = getSiteMessages(locale);
const page = pageId ? getPageContent(locale, pageId) : undefined;
const usesLocalizedRoutes = Astro.props.locale !== undefined;
const resolvedTitle = title ?? page?.meta.title ?? 'Rainrail';
const resolvedDescription = description ?? page?.meta.description ?? site.footer;
const pageTitle =
  resolvedTitle === 'Rainrail' ? resolvedTitle : `${resolvedTitle} - Rainrail`;
const canonicalHref =
  page && Astro.site ? new URL(page.href, Astro.site).toString() : page?.href;
const absolutePageAlternates =
  page && Astro.site
    ? Object.fromEntries(
        Object.entries(page.alternates).map(([alternateLocale, href]) => [
          alternateLocale,
          new URL(href, Astro.site).toString(),
        ]),
      )
    : page?.alternates;
const hrefFor = (targetPageId: PageId) =>
  usesLocalizedRoutes
    ? getLocaleHref(locale, targetPageId)
    : getLegacyHref(targetPageId);
const localeLabel = (targetLocale: Locale) =>
  targetLocale === 'ja' ? '日本語' : 'English';
const languagePreferenceKey = 'rainrail.locale';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={resolvedDescription} />
    <meta name="generator" content={Astro.generator} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {
      absolutePageAlternates &&
        Object.entries(absolutePageAlternates).map(([alternateLocale, href]) => (
          <link rel="alternate" hreflang={alternateLocale} href={href} />
        ))
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="nav" aria-label={site.nav.ariaLabel}>
          <a class="brand" href={hrefFor('home')} aria-label={site.nav.brandLabel}>
            Rainrail
          </a>
          <div class="nav-links">
            {
              site.nav.primary.map((item) => (
                <a href={hrefFor(item.pageId)}>{item.label}</a>
              ))
            }
            <a href="https://github.com/reirei-lab/rainrail">{site.nav.github}</a>
          </div>
          {
            page && (
              <div class="language-switcher" aria-label={site.nav.languageSwitcherLabel}>
                {supportedLocales.map((targetLocale) => (
                  <a
                    href={page.alternates[targetLocale]}
                    data-locale-choice={targetLocale}
                    aria-current={targetLocale === locale ? 'true' : undefined}
                  >
                    {localeLabel(targetLocale)}
                  </a>
                ))}
              </div>
            )
          }
        </nav>
      </header>
      <main class="main">
        <slot />
      </main>
      <footer class="site-footer">
        {site.footer}
      </footer>
    </div>
    <script is:inline define:vars={{ languagePreferenceKey }}>
      document.querySelectorAll('[data-locale-choice]').forEach((link) => {
        link.addEventListener('click', () => {
          const locale = link.getAttribute('data-locale-choice');
          try {
            window.localStorage?.setItem(languagePreferenceKey, locale);
          } catch {
            // Continue navigation even when storage is unavailable.
          }
        });
      });
    </script>
  </body>
</html>
