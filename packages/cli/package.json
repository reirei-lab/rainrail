{
  "name": "@rainrail/cli",
  "version": "0.10.0",
  "private": true,
  "description": "Rainrail command-line interface.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "rainrail": "./dist/bin/rainrail.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-dashboard-assets.mjs && chmod +x dist/bin/rainrail.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
