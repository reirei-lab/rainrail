{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "tag-separator": "/",
  "packages": {
    ".": {
      "component": "release",
      "package-name": "rainrail",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
